NODE_ENV=development
PORT=3000
# Opcional: número exacto de saltos de proxy confiables (p. ej., 1 detrás de Railway, Fly o un balanceador).
# No use true: confiaría cualquier X-Forwarded-For y permitiría evadir los límites por IP.
# TRUST_PROXY=1
APP_URL=http://localhost:3000
JWT_SECRET=replace_for_local_development_salontrack_2026
DATABASE_FILE=./data/salontrack.sqlite
PAYMENT_PROVIDER=local
# Habilitar solo para demostraciones; debe permanecer desactivado en producción.
ALLOW_SIMULATED_PAYMENTS=false
EMAIL_PROVIDER=local
WHATSAPP_PROVIDER=local
MAP_PROVIDER=local
SEED_DEMO_DATA=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional: URL base de la API de Mercado Pago (por defecto, la API oficial).
# MERCADO_PAGO_API_BASE=https://api.mercadopago.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: URL base de la API de Resend (por defecto, la API oficial).
# RESEND_API_BASE=https://api.resend.com