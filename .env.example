# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# JWT_SECRET: Secret key for signing JSON Web Tokens for salon accounts
JWT_SECRET="salontrack_secure_jwt_secret_chile_2026_change_in_production"

# MERCADO PAGO CHILE (Pagos en CLP)
# Token de acceso de producción o prueba de Mercado Pago Chile
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_WEBHOOK_SECRET="whsec_mercado_pago_chile_secret"

# RESEND (Notificaciones y correos transaccionales)
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="SalonTrack Chile <notificaciones@salontrack.cl>"

# DATABASE CONFIGURATION
# SQLite / File-based persistence storage path
DATABASE_FILE="./data/salontrack.json"

