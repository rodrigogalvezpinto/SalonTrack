# =============================================================
# SalonTrack 2.0 — Variables de entorno (desarrollo local)
# Copia este archivo a .env. La app funciona sin credenciales externas.
# Nunca subas valores reales de producción al repositorio.
# =============================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Secreto para firmar JWT. En producción es obligatorio (mín. 32 caracteres)
# y el servidor no arranca con este valor de ejemplo.
JWT_SECRET=replace_for_local_development

# Base de datos SQLite persistente en disco
DATABASE_FILE=./data/salontrack.sqlite
# Almacenamiento JSON v1: se importa automáticamente a SQLite al iniciar (idempotente)
LEGACY_JSON_FILE=./data/salontrack.json
# Carpeta de respaldos (npm run db:backup / db:restore y copias del JSON v1)
BACKUP_DIR=./data/backups

# Proveedores: "local" = simulado y registrado en SQLite, sin servicios externos
PAYMENT_PROVIDER=local
EMAIL_PROVIDER=local
WHATSAPP_PROVIDER=local
MAP_PROVIDER=local

# Carga la cuenta demo si la base está vacía (desactivado por defecto en producción)
SEED_DEMO_DATA=true

# Solo si PAYMENT_PROVIDER=mercadopago (integración real, etapa posterior)
# MERCADO_PAGO_ACCESS_TOKEN=
